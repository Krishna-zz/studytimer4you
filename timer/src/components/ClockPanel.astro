<section class="panel">
	<div class="eyebrow" id="clock-eyebrow">CLOCK</div>
	<div class="clock-hero">
		<div class="display-hero font-jetbrains" id="clock-display">00:00</div>
		<div class="clock-seconds" id="clock-seconds">00</div>
	</div>
	<div class="eyebrow" id="clock-date">Monday, 1 January</div>
	<div class="controls">
		<div class="chip-button" role="group" aria-label="Clock format">
			<button class="option-chip is-selected" data-clock-format="12" type="button" aria-pressed="true">12h</button>
			<button class="option-chip" data-clock-format="24" type="button" aria-pressed="false">24h</button>
		</div>
	</div>
</section>
