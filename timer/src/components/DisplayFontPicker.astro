<section class="font-picker">
	<div class="eyebrow">DISPLAY TYPEFACE</div>
	<div class="font-row" role="radiogroup" aria-label="Timer display font">
		<button class="option-chip is-selected" data-font="jetbrains" role="radio" aria-checked="true">
			<span class="option-chip-preview font-jetbrains">25:00</span>
			<span>JetBrains</span>
		</button>
		<button class="option-chip" data-font="dm-mono" role="radio" aria-checked="false">
			<span class="option-chip-preview font-dm-mono">25:00</span>
			<span>DM Mono</span>
		</button>
		<button class="option-chip" data-font="ibm-plex" role="radio" aria-checked="false">
			<span class="option-chip-preview font-ibm-plex">25:00</span>
			<span>IBM Plex</span>
		</button>
		<button class="option-chip" data-font="space-mono" role="radio" aria-checked="false">
			<span class="option-chip-preview font-space-mono">25:00</span>
			<span>Space Mono</span>
		</button>
		<button class="option-chip" data-font="syne" role="radio" aria-checked="false">
			<span class="option-chip-preview font-syne">25:00</span>
			<span>Syne</span>
		</button>
		<button class="option-chip" data-font="manrope" role="radio" aria-checked="false">
			<span class="option-chip-preview font-manrope">25:00</span>
			<span>Manrope</span>
		</button>
		<button class="option-chip" data-font="sf-pro" role="radio" aria-checked="false" title="SF Pro Display Light">
			<span class="option-chip-preview font-sf-pro">25:00</span>
			<span>SF Pro Light</span>
		</button>
	</div>
</section>
