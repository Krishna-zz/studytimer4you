<section class="panel">
	<div class="eyebrow">STOPWATCH</div>
	<div class="display-hero font-jetbrains" id="stopwatch-display" role="timer" aria-label="Elapsed time">00:00.00</div>
	<div class="controls">
		<button class="button button-primary" id="sw-start" type="button">
			<span id="sw-start-label">Start</span>
			<kbd>Space</kbd>
		</button>
		<button class="icon-button" id="sw-reset" type="button" aria-label="Reset stopwatch">
			<svg viewBox="0 0 24 24">
				<path d="M3 12a9 9 0 1 0 3-6.7"></path>
				<polyline points="3 4 3 10 9 10"></polyline>
			</svg>
		</button>
	</div>
</section>
