<section class="panel">
	<div class="eyebrow" id="timer-eyebrow">TIMER</div>
	<div class="display-hero font-jetbrains" id="timer-display" role="timer" aria-label="Time remaining">25:00</div>
	<div class="controls">
		<button class="button button-primary" id="timer-start" type="button">
			<span id="timer-start-label">Start</span>
			<kbd>Space</kbd>
		</button>
		<button class="icon-button" id="timer-reset" type="button" aria-label="Reset timer">
			<svg viewBox="0 0 24 24">
				<path d="M3 12a9 9 0 1 0 3-6.7"></path>
				<polyline points="3 4 3 10 9 10"></polyline>
			</svg>
		</button>
		<button class="icon-button" id="timer-set" type="button" aria-label="Set time">
			<svg viewBox="0 0 24 24">
				<circle cx="12" cy="12" r="3"></circle>
				<path d="M12 1v6m0 6v10M1 12h6m6 0h10"></path>
			</svg>
		</button>
	</div>
</section>
