---
import Layout from '../layouts/Layout.astro';
import ModeDropdown from '../components/ModeDropdown.astro';
import TimerPanel from '../components/TimerPanel.astro';
import ClockPanel from '../components/ClockPanel.astro';
import StopwatchPanel from '../components/StopwatchPanel.astro';
import DurationDialog from '../components/DurationDialog.astro';
import DisplayFontPicker from '../components/DisplayFontPicker.astro';
---

<Layout>
	<div class="app-shell" id="app-shell">
		<header class="topbar">
			<div class="topbar-left">
				<div class="wordmark">Studytimer4you</div>
			</div>
			<div class="topbar-center">
				<ModeDropdown />
			</div>
			<div class="topbar-right">
				<button class="chip-button" id="focus-toggle" type="button" aria-pressed="false" aria-label="Focus mode">
					<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" fill="none"></circle>
						<path d="M12 1v6m0 6v10M1 12h6m6 0h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
					</svg>
					<span class="focus-label">Focus</span>
				</button>
				<button
					class="chip-button sound-toggle"
					id="sound-toggle"
					type="button"
					aria-pressed="true"
					aria-label="Mute sounds"
				>
					<svg class="sound-on-icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4 9.5h3.5L12 6v12L7.5 14.5H4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
						<path d="M15.5 9.2a4 4 0 0 1 0 5.6M18.2 6.6a7.8 7.8 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
					</svg>
					<svg class="sound-off-icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4 9.5h3.5L12 6v12L7.5 14.5H4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
						<path d="M16 9.5l4.5 5M20.5 9.5l-4.5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
		</header>

		<main class="view-panel">
			<div class="content-view">
				<div class="stage">
					<div class="view-section is-visible" data-view="timer">
						<TimerPanel />
					</div>
					<div class="view-section" data-view="clock">
						<ClockPanel />
					</div>
					<div class="view-section" data-view="stopwatch">
						<StopwatchPanel />
					</div>
				</div>

				<div class="display-settings">
					<DisplayFontPicker />
				</div>
			</div>
		</main>

		<div class="focus-controls" id="focus-controls" hidden>
			<button class="focus-action" id="focus-run" type="button" aria-label="Pause timer">
				<svg class="focus-icon focus-icon-pause" viewBox="0 0 24 24" aria-hidden="true">
					<rect x="6" y="4" width="4" height="16" rx="1" fill="currentColor"></rect>
					<rect x="14" y="4" width="4" height="16" rx="1" fill="currentColor"></rect>
				</svg>
				<svg class="focus-icon focus-icon-play" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M7 4.5v15l13-7.5z" fill="currentColor"></path>
				</svg>
				<span id="focus-run-label">Pause</span>
			</button>
		</div>

		<div class="focus-hint" id="focus-hint">Esc to exit · Space to pause</div>
	</div>

	<DurationDialog />
	<div class="sr-only" id="status" role="status" aria-live="polite"></div>

	<script>
		import '../scripts/app';
	</script>
</Layout>
